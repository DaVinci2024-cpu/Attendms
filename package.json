{
  "name": "attendms",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "comment_dependencies": "electron-updater/electron-log are required directly by electron/main.cjs (the Electron main process, which runs outside the Next.js server) so they stay in \"dependencies\" — electron-builder packages production node_modules for the main process automatically. Everything server.js itself needs is already self-contained inside .next/standalone (see next.config.ts's output: \"standalone\" and scripts/copy-standalone-assets.mjs) — same reasoning as retailrp's dist/server.cjs needing no project node_modules at runtime.",
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "ug.attendms.app",
    "productName": "Attendms",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/standalone/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "REPLACE_WITH_YOUR_UPDATE_SERVER_URL",
      "channel": "latest"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "dir"
    }
  }
}
