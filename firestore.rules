rules_version = '2';

// Single real company. Three kinds of signed-in identity: the permanent
// admin account(s) in adminUids, an employee's own portal account, and —
// as of the Roles & Permissions feature — any account (admin or employee)
// that's been granted specific extra capabilities via a permission grant,
// optionally time-limited. The kiosk itself never signs in at all (see
// README + spec Section 5). Paste this whole file into Firebase console ->
// Firestore Database -> Rules -> Publish.
//
// Known, accepted tradeoff: the kiosk has no login of its own, so
// `employees` (including face descriptors) must stay world-readable for
// the offline-matching architecture to work at all — anyone who obtains
// this project's public web config can read every employee's descriptors
// and the (hashed) PIN/portal-account fields. Physical security of the
// kiosk device and restricting who gets the Firebase config are the real
// mitigations here, not this rules file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId} {
      function isAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && request.auth.uid in
             get(/databases/$(database)/documents/companies/$(companyId)).data.adminUids;
      }

      // True if the signed-in user holds `permission`, either as a
      // permanent admin or via a non-expired grant in /permissions/{uid}.
      // expiresAtMillis is a plain number (Date.now()-comparable), checked
      // against request.time.toMillis() so an expired grant is actually
      // rejected here, not just hidden in the UI.
      function hasPermission(permission) {
        return isAdmin() || (
          request.auth != null &&
          exists(/databases/$(database)/documents/companies/$(companyId)/permissions/$(request.auth.uid)) &&
          permission in get(/databases/$(database)/documents/companies/$(companyId)/permissions/$(request.auth.uid)).data.permissions &&
          (
            get(/databases/$(database)/documents/companies/$(companyId)/permissions/$(request.auth.uid)).data.expiresAtMillis == null ||
            request.time.toMillis() < get(/databases/$(database)/documents/companies/$(companyId)/permissions/$(request.auth.uid)).data.expiresAtMillis
          )
        );
      }

      allow read: if request.auth != null;
      // Bootstrapping: the very first write (creating the company doc, or
      // adding adminUids before it has ever been set) is only reachable by
      // whoever signs in first — which, in practice, is the one admin
      // account created directly in the Firebase console before any
      // employee portal account exists. Once adminUids is set, only an
      // existing admin can change the company doc (including adminUids)
      // further.
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        !("adminUids" in resource.data) ||
        request.auth.uid in resource.data.adminUids
      );

      match /employees/{employeeId} {
        allow read: if true;
        allow create, delete: if hasPermission("manage_employees");
        // An employee may flip their own mustChangePassword flag back to
        // false after setting a real password — nothing else on their own
        // record. Everything else (PIN, descriptors, portal setup) needs
        // manage_employees.
        allow update: if hasPermission("manage_employees") || (
          request.auth != null &&
          resource.data.authUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
        );
      }

      // Attendance is created by the kiosk without signing in and is
      // otherwise append-only — a correction adds an entry to edits[]
      // rather than silently overwriting history. An employee can read
      // their own punches (matched by their linked employee doc's
      // authUid); admin/edit_attendance holders can read everyone's.
      match /attendance/{logId} {
        allow create: if true;
        allow read: if isAdmin() ||
          hasPermission("view_reports") ||
          hasPermission("edit_attendance") || (
          request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)/employees/$(resource.data.employeeId)).data.authUid == request.auth.uid
        );
        // A correction must be made by someone holding edit_attendance,
        // and must append exactly one new entry to edits[] — no editing
        // or deleting prior history, and no changing fields other than
        // timestamp/type/edits in the same write.
        allow update: if hasPermission("edit_attendance") &&
          request.resource.data.edits.size() == (("edits" in resource.data) ? resource.data.edits.size() : 0) + 1 &&
          request.resource.data.edits[request.resource.data.edits.size() - 1].editedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["timestamp", "type", "edits"]);
        allow delete: if false;
      }

      match /suspiciousEvents/{eventId} {
        allow create: if true;
        allow read: if isAdmin();
        allow update, delete: if false;
      }

      // One document per week (weekId = that week's Monday), holding the
      // whole spreadsheet-style grid. Readable by any signed-in user
      // (admin or any employee with a portal account) the same way a
      // printed schedule posted in a break room would be.
      match /schedules/{weekId} {
        allow read: if request.auth != null;
        allow write: if hasPermission("manage_schedule");
      }

      // The kiosk screen's headline/notice text — kept out of the main
      // company doc specifically so it can be world-readable (the kiosk
      // never signs in) without also exposing adminEmail/adminUids.
      match /settings/kioskDisplay {
        allow read: if true;
        allow write: if hasPermission("manage_kiosk_settings");
      }

      // Permission grants. A user can read their own grant (so the UI
      // knows what to show them); only manage_permissions holders can see
      // or change anyone else's, or issue/revoke grants at all.
      match /permissions/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid) || hasPermission("manage_permissions");
        allow write: if hasPermission("manage_permissions");
      }
    }
  }
}
